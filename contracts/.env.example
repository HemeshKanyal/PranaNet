# Copy to contracts/.env (gitignored). Never commit .env.

# Sepolia JSON-RPC endpoint (Alchemy, Infura, or a public one)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Deployer key, 0x-prefixed. Becomes Registry/RewardPool admin. Needs ~0.05 Sepolia ETH.
DEPLOYER_PRIVATE_KEY=
# Optional: verify contracts on Etherscan (https://etherscan.io/myapikey; v2 keys work for Sepolia)
ETHERSCAN_API_KEY=

# Relayer wallet address (same key as relayer/.env RELAYER_PRIVATE_KEY). Gets the backend role
# that registers devices. Defaults to the deployer.
BACKEND_ADDRESS=
# Verifier address (Siddhartha's VERIFIER_PRIVATE_KEY). Can also be granted later:
#   cast send $REGISTRY "setVerifier(address,bool)" <addr> true --private-key $DEPLOYER_PRIVATE_KEY
VERIFIER_ADDRESS=
# Economics (wei)
MIN_STAKE_WEI=1000000000000000
REWARD_PER_EPOCH_WEI=10000000000000

# Percent applied to forge gas estimates when broadcasting (Sepolia CREATE costs ~7x the local simulation). Default 900; stay under the 16.7M per-tx cap.
GAS_ESTIMATE_MULTIPLIER=900
