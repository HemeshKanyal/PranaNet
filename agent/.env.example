# Paying agent. Copy to .env; never commit .env.
API_URL=http://localhost:8082
GEOHASH=te7u6n
# Operator account from https://portal.hedera.com (testnet, ECDSA, hex key). Used once by
# `npm run setup` to create the agent's own account + HCS topic; it is also the API's PAY_TO.
HEDERA_OPERATOR_ID=0.0.11336714
HEDERA_OPERATOR_KEY=0x90bdcd2b612a8b3e822b6a331a86bee28750dba24761d618d3c3abe288dac2dd
AGENT_INITIAL_HBAR=20
# Written by `npm run setup` (never printed): the agent's payer account and its HCS topic
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=
HCS_TOPIC_ID=
# Hard spending caps in tinybars (1 HBAR = 100000000): total per run, and per payment
BUDGET_TINYBAR=50000000
MAX_PER_CALL_TINYBAR=20000000
