# Paid data API (port 8082). Copy to .env; never commit .env.
PORT=8082
# Public base URL (Cloudflare tunnel) advertised in /.well-known/x402
PUBLIC_URL=http://localhost:8082
# Verifier base URL, or "mock" to serve mocks/cell.json
VERIFIER_URL=http://localhost:8081
# "hedera" = x402 on hedera:testnet (default); "off" = free, local dev only
X402=hedera
X402_NETWORK=hedera:testnet
FACILITATOR_URL=https://x402.org/facilitator
# Hedera account (0.0.x) that receives payments (agent `npm run setup` fills this in)
PAY_TO=
# Price per call in tinybars (1 HBAR = 100000000). Default 0.1 HBAR
PRICE_TINYBAR=10000000
# --- revenue bridge (npm run bridge): Hedera income -> RewardPool.fundPool() on Sepolia ---
# Sepolia wallet that pays fundPool (the operator treasury)
TREASURY_PRIVATE_KEY=
SEPOLIA_RPC_URL=
# Default from contracts/deployments/<DEPLOYMENT>.json
REWARD_POOL_ADDRESS=
DEPLOYMENT=sepolia
# Fixed testnet conversion, wei per HBAR (default 1e14 = 0.0001 ETH per HBAR)
HBAR_TO_WEI=100000000000000
# Facilitator account that submits x402 settlements; only its transactions count as revenue
FACILITATOR_FEE_PAYER=0.0.9185802
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
