# Paid data API (port 8082). Copy to .env; never commit .env.
PORT=8082
# Verifier base URL, or "mock" to serve mocks/cell.json
VERIFIER_URL=http://localhost:8081
# "off" serves data without payment (mock phase); "hedera" turns on x402 on hedera:testnet
X402=off
# Hedera account that receives payments
PAY_TO=
