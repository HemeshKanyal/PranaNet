# Copy to relayer/.env (gitignored). Never commit .env.

PORT=8080

# ---- Sepolia
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Relayer wallet: pays gas for submitEpoch and holds the Registry backend role (registerDevice).
# Needs Sepolia ETH (~0.05 covers a day of 2 devices at 60 s epochs).
RELAYER_PRIVATE_KEY=
# Contract addresses default to contracts/deployments/sepolia.json; override here if needed.
REGISTRY_ADDRESS=
READINGS_ADDRESS=
STAKE_ADDRESS=
REWARD_POOL_ADDRESS=
DEPLOY_BLOCK=
# Event polling interval (ms)
POLL_MS=6000

# ---- Arkiv (Rabdi testnet, chain 7794095)
# Free access key: https://hub.arkiv.network/access-keys (empty = public, heavily rate limited)
ARKIV_ACCESS_KEY=
# Writer wallet for Arkiv entities; defaults to RELAYER_PRIVATE_KEY. Fund with tGLM at
# https://hub.arkiv.network/faucet
ARKIV_PRIVATE_KEY=
# false = keep readings in memory only (local testing)
ARKIV_ENABLED=true

# ---- Optional: verifier URL, only used to add value/median to flag entities
VERIFIER_URL=

# ---- CORS / WebSocket origins (comma-separated; * wildcard for one subdomain label)
CORS_ORIGINS=http://localhost:3000,https://*.vercel.app

# ---- ENS (Part 4)
ENS_PARENT=prananet.eth

# ---- World ID (Part 4): from https://developer.world.org
WORLD_APP_ID=
WORLD_ACTION=register-device
WORLD_RP_ID=
WORLD_SIGNING_KEY=
# DEV ONLY: accept POST /register without a proof. Never enable on a public URL.
ALLOW_DEV_REGISTER=false
