# Verifier (port 8081). Copy to .env; never commit .env.
PORT=8081
# Epoch length (must match the devices' EPOCH_SECONDS) and how long after a window closes it is judged
EPOCH_SECONDS=60
GRACE_SECONDS=30
# "mock" = simulated devices only. Otherwise the relayer base URL, e.g. http://localhost:8080:
# real readings come from GET /devices/:ens/readings, simulated readings/flags go back via POST.
RELAYER_URL=http://localhost:8080
# Same value as SIM_TOKEN in relayer/.env (Bearer token for POST /sim/readings and POST /flags)
SIM_TOKEN=
# OpenAQ v3 API key (https://explore.openaq.org/register). "mock" = mocks/station.json
OPENAQ_API_KEY=mock
# Station search radius around each simulated cell's centre, metres (max 25000)
OPENAQ_RADIUS_M=25000
# Cells that get simulated neighbours (comma list) and their fallback PM2.5 x10 without a station
SIM_CELLS=te7u6n
# Name prefix of the simulated devices (<area>-sim-0N.sim.prananet.eth)
SIM_AREA=bkc
SIM_DEFAULT_PM25_X10=480
# Verifier key: needs the verifier role on the Registry (contracts deploy grants it to
# VERIFIER_ADDRESS). Empty = flags are only logged.
VERIFIER_PRIVATE_KEY=
SEPOLIA_RPC_URL=
# Registry address; default from contracts/deployments/<DEPLOYMENT>.json (DEPLOYMENT default sepolia)
REGISTRY_ADDRESS=
DEPLOYMENT=sepolia
