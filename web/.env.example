# Copy to .env.local. Everything empty = full mock mode (web/mocks/*.json).

# Relayer base URL (Hemesh's relayer, port 8080 locally). Empty = mocks.
NEXT_PUBLIC_RELAYER_URL=
# WebSocket for live updates; defaults to NEXT_PUBLIC_RELAYER_URL with ws(s):// + /live.
NEXT_PUBLIC_RELAYER_WS_URL=

# Contracts on Sepolia (from Hemesh once deployed). Empty = mock addresses in mocks/chain.json.
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_READINGS_CONTRACT=
NEXT_PUBLIC_REGISTRY_CONTRACT=

# Arkiv. Empty = mock records. Explorer base URL for entity links (optional).
ARKIV_RPC_URL=
NEXT_PUBLIC_ARKIV_EXPLORER=

# World ID (IDKit 4). Empty app id = simulated proof.
NEXT_PUBLIC_WLD_APP_ID=
NEXT_PUBLIC_WLD_ACTION=register-device
NEXT_PUBLIC_WLD_ENV=staging
# Server-only: signs the IDKit rp_context. Never prefix with NEXT_PUBLIC_.
WLD_RP_ID=
WLD_RP_SIGNING_KEY=
