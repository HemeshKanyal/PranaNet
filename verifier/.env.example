# Verifier (port 8081). Copy to .env; never commit .env.
PORT=8081
# Epoch length in seconds for the cross-check job
EPOCH_SECONDS=60
# "mock" uses simulated devices only; set to the relayer URL to pull real readings too
RELAYER_URL=mock
# "mock" uses mocks/station.json; set an OpenAQ v3 API key to fetch real stations
OPENAQ_API_KEY=mock
# Verifier key for Registry.flag (Sepolia). Leave empty to only log flags.
VERIFIER_PRIVATE_KEY=
REGISTRY_ADDRESS=
SEPOLIA_RPC_URL=
